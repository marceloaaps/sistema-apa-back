{
  "baseUrl": "http://localhost:8080",
  "notes": "Copie os corpos de request para o Insomnia. Use o header 'Authorization: Bearer <token>' onde aplicável. Este arquivo não é um _workspace_ export do Insomnia — é uma coleção de exemplos JSON para facilitar a criação manual de requests.",
  "endpoints": [
    {
      "name": "Register user",
      "method": "POST",
      "url": "/auth/v1/register",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "nome": "Marcelo Silva",
        "email": "marcelo@example.com",
        "dataNascimento": "1995-05-20",
        "senha": "Senha123"
      },
      "sampleResponse": {
        "token": "dsa1ASD7sa1234Ghas2358j",
        "expiresIn": 3600
      }
    },
    {
      "name": "Login",
      "method": "POST",
      "url": "/auth/v1/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "email": "marcelo@example.com",
        "senha": "Senha123"
      },
      "sampleResponse": {
        "token": "eyJ...",
        "expiresIn": 3600
      }
    },
    {
      "name": "Forgot password",
      "method": "POST",
      "url": "/auth/v1/forgot-password",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": { "email": "marcelo@example.com" },
      "sampleResponse": "Token enviado para o email informado. (text)"
    },
    {
      "name": "Reset password",
      "method": "POST",
      "url": "/auth/v1/reset-password",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "token": "token-123456",
        "new_password": "NovaSenha123"
      },
      "sampleResponse": "Senha redefinida com sucesso. (text)"
    },
    {
      "name": "Get usuario by email",
      "method": "GET",
      "url": "/usuarios/v1?email=marcelo@example.com",
      "headers": [],
      "body": null,
      "sampleResponse": {
        "nome": "Marcelo Silva",
        "email": "marcelo@example.com",
        "data_nascimento": "1995-05-20"
      }
    },
    {
      "name": "Update user role",
      "method": "PUT",
      "url": "/configs/v1/{id}",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": { "role": "ADMIN" },
      "sampleResponse": {
        "nome": "Marcelo Silva",
        "email": "marcelo@example.com",
        "data_nascimento": "1995-05-20"
      }
    },
    {
      "name": "Create animal",
      "method": "POST",
      "url": "/animals/v1/create",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer <token>" }
      ],
      "body": {
        "nome": "Rex",
        "idade": 3,
        "raca": "Labrador",
        "rgAnimal": "RG-2024-001",
        "especie": "Cachorro",
        "sexo": "M",
        "cor": "Marrom",
        "comportamento": "Calmo e amigável",
        "historico": "Encontrado na rua, saudável",
        "dataCadastro": "2023-04-01",
        "disponivelParaAdocao": true
      },
      "sampleResponse": {
        "animalDto": {
          "id": 123,
          "nome": "Rex"
        }
      }
    },
    {
      "name": "Update animal",
      "method": "PUT",
      "url": "/animals/v1/{id}",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer <token>" }
      ],
      "body": {
        "nome": "Rex Updated",
        "idade": 4,
        "raca": "Labrador",
        "rgAnimal": "RG-2024-001",
        "especie": "Cachorro",
        "sexo": "M",
        "cor": "Amarelo",
        "comportamento": "Muito calmo",
        "historico": "Encontrado em 2022",
        "dataCadastro": "2023-04-01",
        "disponivelParaAdocao": false
      },
      "sampleResponse": {
        "animalDto": {
          "id": 123,
          "nome": "Rex Updated"
        }
      }
    },
    {
      "name": "Delete animal",
      "method": "DELETE",
      "url": "/animals/v1/{id}",
      "headers": [{ "name": "Authorization", "value": "Bearer <token>" }],
      "body": null,
      "sampleResponse": "(204 No Content)"
    },
    {
      "name": "Restore animal",
      "method": "PATCH",
      "url": "/animals/v1/{id}/restore",
      "headers": [{ "name": "Authorization", "value": "Bearer <token>" }],
      "body": null,
